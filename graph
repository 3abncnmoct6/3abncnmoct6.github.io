<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>그래프 따라 그리기</title>
<style>
  :root {
    --bg: #f4f6fb;
    --card: #ffffff;
    --text: #1d2433;
    --muted: #6b7489;
    --accent: #4f6cf7;
    --accent-dark: #3a55d6;
    --good: #1fa463;
    --bad: #e0464b;
    --border: #e2e6ef;
    --grid: #e9ecf3;
    --axis: #8a93a8;
    --pen: #f08a24;
    --answer: #1fa463;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151d;
      --card: #1c212c;
      --text: #e9ecf3;
      --muted: #98a1b5;
      --border: #2c3342;
      --grid: #262c39;
      --axis: #6f7891;
      --pen: #ffa04a;
      --answer: #3ed68a;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 24px 20px;
    width: 100%;
    max-width: 600px;
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
    text-align: center;
  }
  h1 { margin: 0 0 8px; font-size: 26px; }
  p.sub { margin: 0 0 20px; color: var(--muted); line-height: 1.6; }
  .rules {
    text-align: left;
    background: var(--bg);
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .rules b { color: var(--text); }
  button {
    font: inherit;
    font-weight: 700;
    font-size: 16px;
    border: none;
    border-radius: 12px;
    padding: 12px 22px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    transition: background .15s, transform .05s;
  }
  button:hover { background: var(--accent-dark); }
  button:active { transform: scale(.98); }
  button.ghost {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
  }
  button.ghost:hover { background: var(--border); }
  button:disabled { opacity: .45; cursor: default; }
  .hidden { display: none !important; }

  .topbar {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .topbar b { color: var(--text); font-variant-numeric: tabular-nums; }
  .formula {
    font-family: "Cambria Math", "Times New Roman", serif;
    font-size: 30px;
    font-weight: 600;
    margin: 4px 0 12px;
  }
  .formula i { font-style: italic; }
  .canvas-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--card);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: crosshair;
  }
  .coord {
    position: absolute;
    right: 8px;
    top: 6px;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .controls {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .legend {
    display: flex;
    gap: 16px;
    justify-content: center;
    font-size: 13px;
    color: var(--muted);
    margin-top: 10px;
  }
  .legend span::before {
    content: "";
    display: inline-block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
    vertical-align: middle;
    margin-right: 6px;
    background: var(--c);
  }
  .round-result { margin-top: 14px; }
  .round-score { font-size: 40px; font-weight: 900; color: var(--accent); }
  .round-detail { font-size: 14px; color: var(--muted); margin-top: 2px; }

  .big-score { font-size: 60px; font-weight: 900; color: var(--accent); margin: 8px 0 4px; }
  .grade { font-size: 20px; font-weight: 700; margin-bottom: 18px; }
  .best { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
  .new-best { color: var(--good); font-weight: 700; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 20px; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 4px; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 600; }
  td.f { font-family: "Cambria Math", "Times New Roman", serif; font-size: 16px; }
</style>
</head>
<body>
<div class="card">

  <!-- 시작 화면 -->
  <section id="start">
    <h1>📈 그래프 따라 그리기</h1>
    <p class="sub">함수식을 보고 좌표평면 위에 그래프를 직접 그려보세요!<br>실제 그래프와 비슷할수록 점수가 높아요.</p>
    <div class="rules">
      • 총 <b>5라운드</b>, 라운드마다 <b>새로운 함수식</b>이 나와요<br>
      • 마우스나 손가락으로 좌표평면에 그래프를 그립니다 (여러 번 나눠 그려도 OK)<br>
      • <b>정확도</b>: 그린 선이 실제 그래프에 얼마나 가까운가<br>
      • <b>범위</b>: 화면에 보이는 그래프 구간을 얼마나 빠짐없이 그렸는가<br>
      • 그래프가 없는 곳에 그리면 <b>감점</b> · 라운드당 100점, 만점 <b>500점</b>
    </div>
    <div class="best" id="startBest"></div>
    <button id="startBtn">시작하기</button>
  </section>

  <!-- 게임 화면 -->
  <section id="game" class="hidden">
    <div class="topbar">
      <span>라운드 <b id="roundNum">1</b> / 5</span>
      <span>총점 <b id="totalNow">0</b></span>
    </div>
    <div class="formula" id="formula"></div>
    <div class="canvas-wrap">
      <canvas id="board"></canvas>
      <div class="coord" id="coord"></div>
    </div>
    <div class="legend hidden" id="legend">
      <span style="--c: var(--pen)">내 그래프</span>
      <span style="--c: var(--answer)">정답 그래프</span>
    </div>

    <div class="controls" id="drawControls">
      <button class="ghost" id="undoBtn">↶ 되돌리기</button>
      <button class="ghost" id="clearBtn">지우기</button>
      <button id="submitBtn">제출하기</button>
    </div>

    <div class="round-result hidden" id="roundResult">
      <div class="round-score" id="roundScore">0점</div>
      <div class="round-detail" id="roundDetail"></div>
      <div class="controls">
        <button id="nextBtn">다음 라운드 →</button>
      </div>
    </div>
  </section>

  <!-- 결과 화면 -->
  <section id="result" class="hidden">
    <h1>최종 결과</h1>
    <div class="big-score" id="finalScore">0</div>
    <div class="grade" id="grade"></div>
    <div class="best" id="resultBest"></div>
    <table>
      <thead><tr><th>라운드</th><th>함수</th><th>정확도</th><th>범위</th><th>점수</th></tr></thead>
      <tbody id="review"></tbody>
    </table>
    <button id="retryBtn">다시 하기</button>
  </section>

</div>

<script>
  // ===== 설정 =====
  const ROUNDS = 5;
  const RANGE = 10;        // 좌표평면: x, y 모두 -10 ~ 10
  const SAMPLES = 400;     // 채점용 샘플 개수
  const TOLERANCE = 3;     // 오차가 이 값(좌표 단위) 이상이면 해당 지점 0점
  const BEST_KEY = 'graphDrawBest';

  const $ = id => document.getElementById(id);
  const rand = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;
  const pick = arr => arr[Math.floor(Math.random() * arr.length)];
  const nonZero = (a, b) => { let v; do { v = rand(a, b); } while (v === 0); return v; };

  // ===== 수식 표기 도우미 =====
  const MINUS = '−';
  function num(v) {                // 숫자 표기 (분수 일부 지원)
    const fr = { 0.5: '½', 0.25: '¼', 0.1: '0.1', 0.2: '0.2' };
    const s = v < 0 ? MINUS : '';
    const a = Math.abs(v);
    return s + (fr[a] || String(a));
  }
  function coef(v) {               // 계수: 1 → "", -1 → "−"
    if (v === 1) return '';
    if (v === -1) return MINUS;
    return num(v);
  }
  function plus(v) {               // 상수항: + 3 / − 3 / 생략
    if (v === 0) return '';
    return v > 0 ? ` + ${num(v)}` : ` ${MINUS} ${num(-v)}`;
  }
  function shiftX(h) {             // (x − h)
    if (h === 0) return '<i>x</i>';
    return h > 0 ? `(<i>x</i> ${MINUS} ${h})` : `(<i>x</i> + ${-h})`;
  }
  function shiftXBare(h) {         // |x − h|, √(x − h) 처럼 괄호가 이미 있는 경우
    if (h === 0) return '<i>x</i>';
    return h > 0 ? `<i>x</i> ${MINUS} ${h}` : `<i>x</i> + ${-h}`;
  }

  // ===== 함수 생성기 =====
  const generators = {
    linear() {
      const a = pick([-3, -2, -1, -0.5, 0.5, 1, 2, 3]);
      const b = rand(-5, 5);
      return { f: x => a * x + b, tex: `${coef(a)}<i>x</i>${plus(b)}` };
    },
    quadratic() {
      const a = pick([-1, -0.5, -0.25, 0.25, 0.5, 1]);
      const h = rand(-4, 4), k = rand(-6, 6);
      const sq = h === 0 ? '<i>x</i>²' : `${shiftX(h)}²`;
      return { f: x => a * (x - h) ** 2 + k, tex: `${coef(a)}${sq}${plus(k)}` };
    },
    cubic() {
      const a = pick([0.1, -0.1, 0.05, -0.05]);
      const b = pick([-3, -2, -1, 0, 1]);
      const c = rand(-3, 3);
      const fx = `${num(a)}<i>x</i>³${b === 0 ? '' : (b > 0 ? ' + ' : ` ${MINUS} `) + coef(Math.abs(b)) + '<i>x</i>'}${plus(c)}`;
      return { f: x => a * x ** 3 + b * x + c, tex: fx };
    },
    abs() {
      const a = pick([-2, -1, -0.5, 0.5, 1, 2]);
      const h = rand(-4, 4), k = rand(-5, 5);
      return { f: x => a * Math.abs(x - h) + k, tex: `${coef(a)}|${shiftXBare(h)}|${plus(k)}` };
    },
    sine() {
      const A = pick([2, 3, 4, 5, -3]);
      const B = pick([0.5, 1, 2]);
      const k = rand(-3, 3);
      const fn = pick(['sin', 'cos']);
      const arg = B === 1 ? '<i>x</i>' : `${num(B)}<i>x</i>`;
      const m = fn === 'sin' ? Math.sin : Math.cos;
      return { f: x => A * m(B * x) + k, tex: `${coef(A)} ${fn}(${arg})${plus(k)}` };
    },
    sqrt() {
      const a = pick([-3, -2, 2, 3]);
      const h = rand(-8, 0), k = rand(-5, 5);
      return {
        f: x => (x < h ? NaN : a * Math.sqrt(x - h) + k),
        tex: `${coef(a)}√(${shiftXBare(h)})${plus(k)}`
      };
    },
    exponential() {
      const base = pick([2, 2, 3]);
      const k = rand(-6, 2);
      const neg = Math.random() < 0.4;
      const ex = neg ? `${MINUS}<i>x</i>` : '<i>x</i>';
      return { f: x => base ** (neg ? -x : x) + k, tex: `${base}<sup>${ex}</sup>${plus(k)}` };
    },
    reciprocal() {
      const a = pick([-6, -4, -3, 2, 3, 4, 6]);
      const k = rand(-3, 3);
      return {
        f: x => (Math.abs(x) < 1e-9 ? NaN : a / x + k),
        tex: `${a < 0 ? MINUS : ''}<span style="display:inline-block;vertical-align:middle;text-align:center;font-size:.8em"><span style="display:block;border-bottom:1.5px solid currentColor">${Math.abs(a)}</span><span style="display:block"><i>x</i></span></span>${plus(k)}`
      };
    }
  };

  function makeRounds() {
    const types = Object.keys(generators).sort(() => Math.random() - 0.5).slice(0, ROUNDS);
    return types.map(t => generators[t]());
  }

  // ===== 캔버스 =====
  const canvas = $('board');
  const ctx = canvas.getContext('2d');
  let size = 0;          // CSS 픽셀 기준 한 변 길이
  let strokes = [];      // 각 stroke: [{x, y}] (좌표평면 단위)
  let current = null;
  let revealed = false;

  const css = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const toPx = (x, y) => [(x + RANGE) / (2 * RANGE) * size, (RANGE - y) / (2 * RANGE) * size];
  const toWorld = (px, py) => [px / size * 2 * RANGE - RANGE, RANGE - py / size * 2 * RANGE];

  function resize() {
    const rect = canvas.getBoundingClientRect();
    size = rect.width;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(size * dpr);
    canvas.height = Math.round(size * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    draw();
  }

  function drawGrid() {
    ctx.fillStyle = css('--card');
    ctx.fillRect(0, 0, size, size);

    ctx.lineWidth = 1;
    ctx.strokeStyle = css('--grid');
    for (let i = -RANGE; i <= RANGE; i++) {
      const [px] = toPx(i, 0);
      const [, py] = toPx(0, i);
      ctx.beginPath(); ctx.moveTo(px, 0); ctx.lineTo(px, size); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, py); ctx.lineTo(size, py); ctx.stroke();
    }

    // 축
    const [ox, oy] = toPx(0, 0);
    ctx.strokeStyle = css('--axis');
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(0, oy); ctx.lineTo(size, oy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(ox, 0); ctx.lineTo(ox, size); ctx.stroke();

    // 눈금 숫자
    ctx.fillStyle = css('--muted');
    ctx.font = `${Math.max(10, size / 50)}px system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let i = -RANGE + 2; i < RANGE; i += 2) {
      if (i === 0) continue;
      const [px] = toPx(i, 0);
      ctx.fillText(String(i).replace('-', MINUS), px, oy + 4);
    }
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (let i = -RANGE + 2; i < RANGE; i += 2) {
      if (i === 0) continue;
      const [, py] = toPx(0, i);
      ctx.fillText(String(i).replace('-', MINUS), ox - 5, py);
    }
    ctx.textAlign = 'right';
    ctx.textBaseline = 'top';
    ctx.fillText('O', ox - 5, oy + 4);

    ctx.font = `italic ${Math.max(12, size / 38)}px "Times New Roman", serif`;
    ctx.textAlign = 'right';
    ctx.textBaseline = 'bottom';
    ctx.fillText('x', size - 6, oy - 4);
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    ctx.fillText('y', ox + 6, 4);
  }

  function drawStrokes() {
    ctx.strokeStyle = css('--pen');
    ctx.lineWidth = 3;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    for (const s of strokes.concat(current ? [current] : [])) {
      if (s.length === 0) continue;
      ctx.beginPath();
      s.forEach((p, i) => {
        const [px, py] = toPx(p.x, p.y);
        i ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
      });
      if (s.length === 1) {
        const [px, py] = toPx(s[0].x, s[0].y);
        ctx.lineTo(px + 0.1, py);
      }
      ctx.stroke();
    }
  }

  function drawAnswer(f) {
    ctx.strokeStyle = css('--answer');
    ctx.lineWidth = 3;
    ctx.setLineDash([]);
    ctx.beginPath();
    let pen = false, prevY = null;
    const steps = 1200;
    for (let i = 0; i <= steps; i++) {
      const x = -RANGE + (2 * RANGE) * i / steps;
      const y = f(x);
      // 정의되지 않거나, 화면 밖으로 크게 벗어나거나, 불연속(점프)이면 선을 끊음
      if (!isFinite(y) || Math.abs(y) > RANGE * 3 || (prevY !== null && Math.abs(y - prevY) > RANGE)) {
        pen = false; prevY = isFinite(y) ? y : null;
        if (!isFinite(y)) continue;
      }
      const [px, py] = toPx(x, Math.max(-RANGE * 3, Math.min(RANGE * 3, y)));
      pen ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
      pen = true; prevY = y;
    }
    ctx.stroke();
  }

  function draw() {
    if (!size) return;
    drawGrid();
    if (revealed) drawAnswer(rounds[roundIdx].f);
    drawStrokes();
  }

  // ===== 그리기 입력 =====
  function eventWorld(e) {
    const rect = canvas.getBoundingClientRect();
    return toWorld(e.clientX - rect.left, e.clientY - rect.top);
  }

  canvas.addEventListener('pointerdown', e => {
    if (revealed) return;
    canvas.setPointerCapture(e.pointerId);
    const [x, y] = eventWorld(e);
    current = [{ x, y }];
    draw();
  });
  canvas.addEventListener('pointermove', e => {
    const [x, y] = eventWorld(e);
    if (Math.abs(x) <= RANGE && Math.abs(y) <= RANGE) {
      $('coord').textContent = `(${x.toFixed(1)}, ${y.toFixed(1)})`;
    }
    if (!current) return;
    const cx = Math.max(-RANGE, Math.min(RANGE, x));
    const cy = Math.max(-RANGE, Math.min(RANGE, y));
    current.push({ x: cx, y: cy });
    draw();
  });
  const endStroke = () => {
    if (!current) return;
    if (current.length > 1) strokes.push(current);
    current = null;
    updateButtons();
    draw();
  };
  canvas.addEventListener('pointerup', endStroke);
  canvas.addEventListener('pointercancel', endStroke);
  canvas.addEventListener('pointerleave', () => { $('coord').textContent = ''; });

  function updateButtons() {
    const empty = strokes.length === 0;
    $('undoBtn').disabled = empty;
    $('clearBtn').disabled = empty;
    $('submitBtn').disabled = empty;
  }

  // ===== 채점 =====
  function grade(f) {
    const sum = new Array(SAMPLES + 1).fill(0);
    const cnt = new Array(SAMPLES + 1).fill(0);
    const xAt = i => -RANGE + (2 * RANGE) * i / SAMPLES;
    const step = (2 * RANGE) / SAMPLES;

    // 사용자가 그린 선을 x 샘플마다 선형 보간 (같은 x에 여러 값이 있으면 평균)
    for (const s of strokes) {
      for (let j = 1; j < s.length; j++) {
        const p = s[j - 1], q = s[j];
        const lo = Math.min(p.x, q.x), hi = Math.max(p.x, q.x);
        const iStart = Math.ceil((lo + RANGE) / step);
        const iEnd = Math.floor((hi + RANGE) / step);
        for (let i = Math.max(0, iStart); i <= Math.min(SAMPLES, iEnd); i++) {
          const x = xAt(i);
          const t = hi === lo ? 0.5 : (x - p.x) / (q.x - p.x);
          sum[i] += p.y + t * (q.y - p.y);
          cnt[i]++;
        }
      }
    }

    let valid = 0, covered = 0, accSum = 0, extra = 0;
    for (let i = 0; i <= SAMPLES; i++) {
      const y = f(xAt(i));
      const inView = isFinite(y) && Math.abs(y) <= RANGE;
      if (!inView) {
        if (cnt[i] > 0) extra++;   // 그래프가 없는(또는 화면 밖인) 곳에 그림
        continue;
      }
      valid++;
      if (cnt[i] === 0) continue;
      covered++;
      const err = Math.abs(sum[i] / cnt[i] - y);
      accSum += Math.max(0, 1 - err / TOLERANCE);
    }

    const accuracy = covered ? accSum / covered : 0;
    const coverage = valid ? covered / valid : 0;
    const score = valid ? Math.round(100 * accSum / (valid + extra * 0.5)) : 0;
    return { score, accuracy, coverage };
  }

  // ===== 게임 진행 =====
  let rounds = [], roundIdx = 0, total = 0, history = [];

  function getBest() { try { return parseInt(localStorage.getItem(BEST_KEY)) || 0; } catch { return 0; } }
  function setBest(v) { try { localStorage.setItem(BEST_KEY, v); } catch {} }
  function showBest(el) { const b = getBest(); el.textContent = b ? `🏆 최고 기록: ${b}점` : ''; }

  function show(id) {
    ['start', 'game', 'result'].forEach(s => $(s).classList.toggle('hidden', s !== id));
  }

  function startGame() {
    rounds = makeRounds();
    roundIdx = 0; total = 0; history = [];
    $('totalNow').textContent = 0;
    show('game');
    resize();
    loadRound();
  }

  function loadRound() {
    strokes = []; current = null; revealed = false;
    $('roundNum').textContent = roundIdx + 1;
    $('formula').innerHTML = `<i>y</i> = ${rounds[roundIdx].tex}`;
    $('drawControls').classList.remove('hidden');
    $('roundResult').classList.add('hidden');
    $('legend').classList.add('hidden');
    updateButtons();
    draw();
  }

  function submitRound() {
    if (!strokes.length) return;
    const r = rounds[roundIdx];
    const g = grade(r.f);
    total += g.score;
    history.push({ tex: r.tex, ...g });
    revealed = true;
    draw();

    $('totalNow').textContent = total;
    $('roundScore').textContent = `${g.score}점`;
    $('roundDetail').textContent =
      `정확도 ${Math.round(g.accuracy * 100)}% · 범위 ${Math.round(g.coverage * 100)}%`;
    $('drawControls').classList.add('hidden');
    $('roundResult').classList.remove('hidden');
    $('legend').classList.remove('hidden');
    $('nextBtn').textContent = roundIdx + 1 < ROUNDS ? '다음 라운드 →' : '최종 결과 보기';
    $('nextBtn').focus();
  }

  function nextRound() {
    roundIdx++;
    if (roundIdx < ROUNDS) loadRound();
    else endGame();
  }

  function endGame() {
    $('finalScore').textContent = total;
    const ratio = total / (ROUNDS * 100);
    $('grade').textContent =
      ratio >= .9 ? '🎯 인간 그래프 계산기!' :
      ratio >= .75 ? '🔥 그래프 감각이 뛰어나요!' :
      ratio >= .6 ? '👍 잘했어요!' :
      ratio >= .4 ? '🙂 조금만 더 연습해봐요!' : '💪 다시 도전해봐요!';

    const prev = getBest();
    if (total > prev) {
      setBest(total);
      $('resultBest').innerHTML = `<span class="new-best">🎉 새로운 최고 기록!</span>${prev ? ` (이전 ${prev}점)` : ''}`;
    } else {
      showBest($('resultBest'));
    }

    $('review').innerHTML = history.map((h, i) => `
      <tr>
        <td>${i + 1}</td>
        <td class="f"><i>y</i> = ${h.tex}</td>
        <td>${Math.round(h.accuracy * 100)}%</td>
        <td>${Math.round(h.coverage * 100)}%</td>
        <td><b>${h.score}</b></td>
      </tr>`).join('');
    show('result');
  }

  $('startBtn').addEventListener('click', startGame);
  $('retryBtn').addEventListener('click', startGame);
  $('submitBtn').addEventListener('click', submitRound);
  $('nextBtn').addEventListener('click', nextRound);
  $('undoBtn').addEventListener('click', () => { strokes.pop(); updateButtons(); draw(); });
  $('clearBtn').addEventListener('click', () => { strokes = []; updateButtons(); draw(); });
  window.addEventListener('resize', resize);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', draw);
  showBest($('startBest'));
</script>
</body>
</html>
